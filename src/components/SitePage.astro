---
import Base from '../layouts/Base.astro';
import Hero from './sections/Hero.astro';
import About from './sections/About.astro';
import Services from './sections/Services.astro';
import Pricing from './sections/Pricing.astro';
import Gallery from './sections/Gallery.astro';
import Video from './sections/Video.astro';
import Testimonials from './sections/Testimonials.astro';
import Faq from './sections/Faq.astro';
import MapSection from './sections/MapSection.astro';
import Contact from './sections/Contact.astro';
import Social from './sections/Social.astro';
import Cta from './sections/Cta.astro';
import PreviewPanel from '../demo/PreviewPanel.astro';

const { site, preview = false, panel = null } = Astro.props;

// Registri blok: tambah jenis section baru cukup daftarkan di sini.
const registry = {
  hero: Hero, about: About, services: Services, pricing: Pricing,
  gallery: Gallery, video: Video, testimonials: Testimonials, faq: Faq,
  map: MapSection, contact: Contact, social: Social, cta: Cta,
};
const sections = (site.sections || []).filter((s) => s.enabled !== false && registry[s.type]);
---
<Base site={site} sections={sections} noindex={preview}>
  {preview && !panel && <a class="pv" href="/coba">← Ubah data uji coba</a>}
  {preview && panel && <PreviewPanel {...panel} />}
  {sections.map((s, i) => {
    const C = registry[s.type];
    return <C data={s} site={site} alt={i % 2 === 1} />;
  })}
  {preview && (
    <script is:inline>
      (function () {
        var f = {};
        try { f = JSON.parse(sessionStorage.getItem('coba.fotos') || '{}'); } catch (e) {}
        function key(u) { var m = /[?&]foto=([a-z0-9]+)/.exec(u || ''); return m ? m[1] : null; }
        document.querySelectorAll('img[src*="foto="]').forEach(function (i) {
          var k = key(i.getAttribute('src')); if (k && f[k]) i.src = f[k];
        });
        var ic = document.querySelector('link[rel="icon"]');
        if (ic) { var k2 = key(ic.getAttribute('href')); if (k2 && f[k2]) ic.href = f[k2]; }
      })();
    </script>
  )}
</Base>
