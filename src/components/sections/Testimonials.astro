---
const { data, alt } = Astro.props;
const items = data.items || [];
---
<section class={`s${alt ? ' alt' : ''}`} id={data.id || 'testimonials'}>
  <div class="wrap">
    <div class="s-head"><h2>{data.title}</h2></div>
    <div class="grid c3">
      {items.map((t) => (
        <blockquote class="card" style="margin:0">
          <div class="stars" aria-label={`${t.rating || 5} dari 5 bintang`}>{'★'.repeat(Number(t.rating || 5))}</div>
          <p>“{t.text}”</p>
          <footer><strong>{t.name}</strong>{t.role ? `, ${t.role}` : ''}</footer>
        </blockquote>
      ))}
    </div>
  </div>
</section>
